GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Platforma echipei (/echipa). Cheile publice din Supabase → Project Settings → API.
# Sunt publice prin design; securitatea vine din regulile RLS din baza de date.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cheia-anon-publica

# Opționale: linkuri afișate în platformă (pot fi setate și în src/echipa/config.ts).
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_WHATSAPP_GROUP_URL=
NEXT_PUBLIC_DISCORD_URL=

# ATENȚIE: cheia service_role și codul de invitație (INVITE_CODE) NU se pun aici
# și nici în Netlify. Stau doar ca secrete în Supabase → Edge Functions → Secrets.
